{
  "gr_module_config":{
      "root_path":"python/LLM4REC/game_rpk_mtgr_v1",
      "common_hp":{
          "data_loader_conf":{
            "dataset_name": "Game",
            "prefetch_factor": 4,
            "num_workers": 8,
            "history_length": 150,
            "num_rerank": 150,  # 这里会传到conca_dataset中的_max_candidate_num
            "train_data_path": "parquet_data_20/train", # 默认是0906的数据集名称
            "valid_data_path": "parquet_data_20/valid", # 默认是0906的数据集名称
            "use_dynamic_padding": true,
            "padding_bucket_size": -1,
            "padding_bucket_table": [1, 2, 4, 8, 16, 24, 32, 48, 64, 96, 128, 192, 256, 384, 512],
            "padding_side_origin": "left", # padding size in the data
            "padding_side": "right" # padding side processed in the code
          },
          "seed_conf": {
            "global_seed": 3407
          },
          "model_conf": {
            "val_spl_recov":false,
            "linear_weigh": 1,
            "item_embedding_dim": 256,  # 特征维度，要同步改后面attention的dv
            "max_sequence_length": 800,
            "gr_output_length": 0,
            "output_embedding_dim": 1,
            "num_ratings": 5, # action种类数
            "linear_dropout_rate": 0.2,
            "attn_dropout_rate": 0.0,
            "user_embedding_norm": "l2_norm",
            "use_fbgemm": true,
            "rab_aggregate_method": "sum", ## 可选项"concat", "sum"
            "linear_activation": "silu",
            "normalization": "rel_bias", ## 可选项"att_free_bias", "rel_bias"
            "linear_config": "uvqk",
            "use_action_emb": True,
            "use_user_embeddings_for_rerank": True,

            "use_hstu": True,
            "use_gluffn": True,
            "use_emb_rmsnorm": true,
            "amp_dtype": "fp16",
            "debug_sanitize": null,
            "use_enhanced_interest_embeddings": False,  # SRN开
            "use_dlrm": True,  # DLRM开关
            'use_baseline_dcn': False,
            'use_baseline_ppnet': True,
            'target_features': ['domain_type1'],

            'gauc_querys': [{'ctype': [2]},
                            {'ctype': [3]}],
            "truncate_timestamps_feature": True, # 线上处理时间戳特征开关
            "oper_date_truncate_times": 1000000,
            "oper_time_truncate_times": 1000
          },
          "export_conf": {
            "last_k": 1,
            "export_batch_size": 1,
            "export_num_batch": 1,
            "save_dir_name": "modelfile",
            "num_rerank": 300, # 与验证集一条样本的candidate最大数目保持一致
            "need_export_csv": False,
            "compute_auc_on_export": False,
            "export_mode": "fake", #["real", "fake"]导出的时候选择使用真实数据集还是虚拟数据集
          },
          "train_conf": {
            "phase": "train", # pretrain or train
            "load_ano_sim": True,
            "load_ano_hstu": False,
            "load_ano_hstu_path": "/opt/huawei/dataset/data_dir/baseline_20250906/model/sim-v4-test1/modelfile/model_hstu_0.pth",
            "load_sim_embedding": False,
            "frozen_embedding": False,
            "jump_eval_during_train": False, # 跳过eval?
            "add_pos_emb": False,
            "add_rope_emb": False,
            "add_fixed_pos_emb": False,
            "add_fixed_time_aware_pos_emb": False, # candidate时间戳为0，position_embedding有问题
            "_use_pos_emb": True,
            "_pos_aligned_side": "right",
            "is_output_loss_csv_file": False,
            "lr_scaling": "Linear",
            "beta": [ 0.9, 0.98 ],
            "learning_rate": 0.00001,
            "optimizer_type": "AdamW",
            "weight_decay": 0.000001,
            "local_batch_size": 1024,  # 128
            "eval_batch_size": 1024,
            "dropout_rate": 0.2,
            "eval_interval": 100,
            "num_epochs": 1,
            "num_warmup_steps": 500,
            "lr_schedule_type": "constant",
            "total_training_steps": 0,
            "sampling_strategy": "local",
            "temperature": 0.05,
            "use_item_l2_norm": True,
            "use_tf32": True,
            "full_eval_every_n": 1,
            "batch_limit": 500, # 跑全量数据的时候为False，debug的时候为了节约时间可以设置为较小的数如300以节约时间
            "eval_ng_ratio": 1,
            "use_amp": true,
            "loss_scale": 65536,
            "dynamic_loss_scale": true,
            "use_profiler": false,
            "profiler_output_dir": "./profiler_result",
            "profiler_record_shapes": false,
            "profiler_profile_memory": false
          },
          "feature_conf": {
            "save_result_to_local": False,
            "cut_off_bias": 0,
            "cut_off_time": 0,
            "time_desc": True,
            "chronological": False,
            "get_count_from_featuremap": True, #当此处为True时,下方"item_feature_columns"与"user_feature_columns"中的feature_count将被忽略，其值将从feature_map中推断.

            "candidate_items_key": "app_id",
            "history_items_key": "app_id_list",

            "candidate_timestamps_column": "oper_time",
            "history_timestamps_column": "action_timestamp_list",

            "candidate_date_column": "oper_date",
            "history_date_column": "oper_date_list",

            "candidate_ratings_column": "label",
            "history_ratings_column": "action_type_list",

            "action_types": ["history"],
            "save_score_csv_item_cols": {"ctype": ""},

            "padding_index": 0,
            "padding_length_pref": 0, # pref特征填充的长度
            "fuse_ia": True, # 融合action token
            "candidate_item_feature_columns": {
                # 所有特征都需要写上去,item_id必须包含。若上方get_count_from_featuremap设置为False，需要手动填入每个特征的maxIndex+1作为feature_count
                # enabled 是否启用该特征。 dytpe int为离散特征，con为连续特征，multi为多值特征，context为上下文特征;
                # max_len可选，表示单特征最大长度，多值为>1；
                # shared_feat_name可选，表示共享id的原始特征
                "app_id": {"dim": 64, "feature_count": 1414889, "enabled": True, "dtype": "int", "shared_feat_name": "app_id"},
                "app_size": {"dim": 64, "feature_count": 60, "enabled": True, "dtype": "int", "shared_feat_name": "app_size"},
                "first_grade": {"dim": 64, "feature_count": 60, "enabled": True, "dtype": "int", "shared_feat_name": "first_grade"},
                "dev_up_id": {"dim": 64, "feature_count": 25, "enabled": True, "dtype": "int", "shared_feat_name": "dev_up_id"},
                "app_second_type": {"dim": 64, "feature_count": 11, "enabled": True, "dtype": "int", "shared_feat_name": "app_second_type"},
                "app_third_type": {"dim": 64, "feature_count": 3, "enabled": True, "dtype": "int", "shared_feat_name": "app_third_type"},
                "game_type_cd": {"dim": 64, "feature_count": 60, "enabled": True, "dtype": "int", "shared_feat_name": "game_type_cd"},
                "first_time_days": {"dim": 64, "feature_count": 60, "enabled": True, "dtype": "int", "shared_feat_name": "first_time_days"},
                "game_type": {"dim": 64, "feature_count": 60, "enabled": True, "dtype": "int", "shared_feat_name": "game_type"},
                "ctype": {"dim": 64, "feature_count": 60, "enabled": True, "dtype": "int", "shared_feat_name": "ctype"},
                "list_id": {"dim": 64, "feature_count": 60, "enabled": True, "dtype": "int", "shared_feat_name": "list_id"},
                "is_down_target_item_flag": {"dim": 64, "feature_count": 2, "enabled": True, "dtype": "int", "shared_feat_name": "is_down_target_item_flag"},
                "is_pay_target_item_flag": {"dim": 64, "feature_count": 2, "enabled": True, "dtype": "int", "shared_feat_name": "is_pay_target_item_flag"},
                "is_use_tagert_item_flag": {"dim": 64, "feature_count": 2, "enabled": True, "dtype": "int", "shared_feat_name": "is_use_tagert_item_flag"},
                "user_match_item_profile_flag": {"dim": 64, "feature_count": 2, "enabled": True, "dtype": "int", "shared_feat_name": "user_match_item_profile_flag"},

                "age_gender_profile_list": {"dim": 64, "max_len": 10, "feature_count": 1414889, "enabled": True, "dtype": "multi", "shared_feat_name": "age_gender_profile_list"},
                "browse_game_app_list_w2": {"dim": 64, "max_len": 10, "feature_count": 1414889, "enabled": True, "dtype": "multi", "shared_feat_name": "app_id"},
                "click_not_down_game_app_list_w2": {"dim": 64, "max_len": 10, "feature_count": 1414889, "enabled": True, "dtype": "multi", "shared_feat_name": "app_id"},
                "use_game_app_list_w2": {"dim": 64, "max_len": 10, "feature_count": 1414889, "enabled": True, "dtype": "multi", "shared_feat_name": "app_id"},
                "down_game_app_list_w2": {"dim": 64, "max_len": 10, "feature_count": 1414889, "enabled": True, "dtype": "multi", "shared_feat_name": "app_id"},
                "user_down_list_search_stype_180d": {"dim": 64, "max_len": 10, "feature_count": 1414889, "enabled": True, "dtype": "multi", "shared_feat_name": "app_id"},
                "user_down_list_search_ttype_180d": {"dim": 64, "max_len": 10, "feature_count": 1414889, "enabled": True, "dtype": "multi", "shared_feat_name": "app_id"},
                "down_game_list_180d": {"dim": 64, "max_len": 10, "feature_count": 1414889, "enabled": True, "dtype": "multi", "shared_feat_name": "app_id"},
                "usage_game_list_180d": {"dim": 64, "max_len": 10, "feature_count": 1414889, "enabled": True, "dtype": "multi", "shared_feat_name": "app_id"},
                "down_pure_app_list_180d": {"dim": 64, "max_len": 10, "feature_count": 1414889, "enabled": True, "dtype": "multi", "shared_feat_name": "app_id"},
                "user_pay_list_360": {"dim": 64, "max_len": 10, "feature_count": 1414889, "enabled": True, "dtype": "multi", "shared_feat_name": "app_id"},
                "use_pure_app_list_180d": {"dim": 64, "max_len": 10, "feature_count": 1414889, "enabled": True, "dtype": "multi", "shared_feat_name": "app_id"},
            },
            "history_item_feature_columns": {
                "app_id_list": {"dim": 64, "feateewure_count": 1414889, "enabled": True, "dtype": "int", "shared_feat_name": "app_id"},
                "app_size_list": {"dim": 64, "feature_count": 1414889, "enabled": True, "dtype": "int", "shared_feat_name": "app_size"},
                "first_grade_list": {"dim": 64, "feature_count": 1414889, "enabled": True, "dtype": "int", "shared_feat_name": "first_grade"},
                "dev_up_id_list": {"dim": 64, "feature_count": 1414889, "enabled": True, "dtype": "int", "shared_feat_name": "dev_up_id"},
                "app_second_type_list": {"dim": 64, "feature_count": 1414889, "enabled": True, "dtype": "int", "shared_feat_name": "app_second_type"},
                "app_third_type_list": {"dim": 64, "feature_count": 1414889, "enabled": True, "dtype": "int", "shared_feat_name": "app_third_type"},
                "game_type_cd_list": {"dim": 64, "feature_count": 1414889, "enabled": True, "dtype": "int", "shared_feat_name": "game_type_cd"},
                "first_time_days_list": {"dim": 64, "feature_count": 1414889, "enabled": True, "dtype": "int", "shared_feat_name": "first_time_days"},
                "ctype_list": {"dim": 64, "feature_count": 1414889, "enabled": True, "dtype": "int", "shared_feat_name": "ctype"},
                "app_cn_name_list": {"dim": 64, "feature_count": 1414889, "enabled": True, "dtype": "int", "shared_feat_name": "app_cn_name_list"}
            },
            "raw_item_info_column": "",
            "user_feature_columns": {
                "product_name": {"dim": 64, "feature_count": 1414889, "enabled": True, "dtype": "int", "shared_feat_name": "product_name"},
                "activa_durati_day": {"dim": 64, "feature_count": 1414889, "enabled": True, "dtype": "int", "shared_feat_name": "activa_durati_day"},
                "city": {"dim": 64, "feature_count": 1414889, "enabled": True, "dtype": "int", "shared_feat_name": "city"},
                "gender_age": {"dim": 64, "feature_count": 1414889, "enabled": True, "dtype": "int", "shared_feat_name": "gender_age"},
                "age": {"dim": 64, "feature_count": 1414889, "enabled": True, "dtype": "int", "shared_feat_name": "age"},
                "gender": {"dim": 64, "feature_count": 1414889, "enabled": True, "dtype": "int", "shared_feat_name": "gender"},
                "domain_type1": {"dim": 64, "feature_count": 60, "enabled": True, "dtype": "int", "shared_feat_name": "domain_type1"},
            },
            "feature_groups":{
              "candidate_dlrm": {
                "features": [
                    "app_id",
                    "app_size",
                    "first_grade",
                    "dev_up_id",
                    "app_second_type",
                    "app_third_type",
                    "game_type_cd",
                    "first_time_days",
                    "game_type",
                    "ctype",
                    "list_id",
                    "is_down_target_item_flag",
                    "is_pay_target_item_flag",
                    "is_use_tagert_item_flag",
                    "user_match_item_profile_flag",
                    "age_gender_profile_list",
                    "browse_game_app_list_w2",
                    "click_not_down_game_app_list_w2",
                    "use_game_app_list_w2",
                    "down_game_app_list_w2",
                    "user_down_list_search_stype_180d",
                    "user_down_list_search_ttype_180d",
                    "down_game_list_180d",
                    "usage_game_list_180d",
                    "down_pure_app_list_180d",
                    "user_pay_list_360",
                    "use_pure_app_list_180d"
                ]
              },
              "candidate": {
                "features": [
                    "app_id",
                    "app_size",
                    "first_grade",
                    "dev_up_id",
                    "app_second_type",
                    "app_third_type",
                    "game_type_cd",
                    "first_time_days",
                    "game_type",
                    "ctype",
                    "list_id",
                    "is_down_target_item_flag",
                    "is_pay_target_item_flag",
                    "is_use_tagert_item_flag",
                    "user_match_item_profile_flag",
                    "age_gender_profile_list",
                    "browse_game_app_list_w2",
                    "click_not_down_game_app_list_w2",
                    "use_game_app_list_w2",
                    "down_game_app_list_w2",
                    "user_down_list_search_stype_180d",
                    "user_down_list_search_ttype_180d",
                    "down_game_list_180d",
                    "usage_game_list_180d",
                    "down_pure_app_list_180d",
                    "user_pay_list_360",
                    "use_pure_app_list_180d"
                ],
                "mlp": {
                  "hidden_dims": [512],  # 可配置隐藏层，空list []表示不用隐藏层
                  "act_fn": "gelu"  # none则表示不使用，可选gelu, relu, sigmoid, tanh
                },
                "gluffn": {
                  "ffn_dim_multiplier": 6,
                }
              },
              "history": {
                "history": {
                  "features": [
                    "app_id_list",
                    "app_size_list",
                    "first_grade_list",
                    "dev_up_id_list",
                    "app_second_type_list",
                    "app_third_type_list",
                    "game_type_cd_list",
                    "first_time_days_list",
                    "ctype_list",
                    "app_cn_name_list",
                  ]
                },
                "mlp": {
                  "hidden_dims": [512],  # 可配置隐藏层，空list []表示不用隐藏层
                  "act_fn": "gelu"  # none则表示不使用，可选gelu, relu, sigmoid, tanh
                },
                "gluffn": {
                  "ffn_dim_multiplier": 6,
                }
              },
              "user": {
                "features": [
                    "product_name",
                    "activa_durati_day",
                    "city",
                    "gender_age",
                    "age",
                    "gender",
                    "domain_type1",
                ],
                "mlp": {
                  "hidden_dims": [512],  # 可配置隐藏层，空list []表示不用隐藏层
                  "act_fn": "gelu"  # none则表示不使用，可选gelu, relu, sigmoid, tanh
                },
                "gluffn": {
                  "ffn_dim_multiplier": 6,
                }
              },
            },
            "metric_list": [
              { "tag": "mean" },
              { "tag": "variance" },
              { "tag": "stddev" },
              { "tag": "logloss" },
              { "tag": "pcoc" },
              { "tag": "auc" },
            ],
          }
      },
      "model_cfg": {
        "name": "MultiSeqMTGRModel",
        "path": "modeling/generic/sequential/multi_seq_mtgr_model.py",
        "cls_name": "MultiSeqMTGRModel",
        "is_customize": true,
        "hp": {
          "verbose": true,
          "use_sid": true,
          "sid_Ks": [256, 256, 256],
          "appid2sids_path": "/home/ma-user/work/dataset/mini_game_dataset/sid/20260623/appid2sids.txt",
          "id_col_name": "app_id",
          "code_col_name": "code",
          "cumsum": true,
          "unique": false,
          "app_zero": true,
          "sid_decoder_in_dropout": 0.2,
          "sid_gen_loss_w": 0.1,
          "sid_gen_loss_strat": "unlikelihood",
          "unlikelihood_w": 0.5,
          "sid_decoder_as_dlrm_input": false,
          "sid_decoder_tau": 0.5
        },
        "sub_models": {
          "AttentionMaskModule": {
            "name": "AttentionMaskModule",
            "path": "modeling/generic/sequential/attn_mask_modules.py",
            "cls_name": "AttentionMaskModule",
            "is_customize": true,
            "hp": { },
            "sub_models": {
              "CausalAttentionMask": {
                "name": "CausalAttentionMask",
                "path": "modeling/generic/sequential/attn_mask_modules.py",
                "cls_name": "CausalAttentionMask",
                "is_customize": true,
                "hp": { }
              }
            }
          },
          "EmbeddingModule": {
            "name": "LocalEmbeddingModuleWithSideInfo",
            "path": "modeling/generic/sequential/embedding_modules.py",
            "cls_name": "LocalEmbeddingModuleWithSideInfo",
            "is_customize": true,
            "hp": { }
          },
          "SRNModule": {
            "name": "SRNModule",
            "path": "modeling/generic/sequential/srn_module.py",
            "cls_name": "SRNModule",
            "is_customize": true,
            "hp": {
              "num_bins": 10,
              "embedding_size": 128,
              "sim_gate_w": 10.0,
              "sim_gate_b": 9.0,
              "sim_gate_trainable": true,
              "binning_type": "default"
            }
          },
          "InputFeaturesPreprocessorModule": {
            "name": "UserItemInputFeaturePreprocessor",
            "path": "modeling/generic/sequential/input_features_preprocessors.py",
            "cls_name": "UserItemInputFeaturePreprocessor",
            "is_customize": true,
            "hp": {
              "embedding_dropout_rate": 0.2
            }
          },
          "LossModule": {
            "name": "LossModule",
            "path": "modeling/generic/sequential/loss_modules.py",
            "cls_name": "LossModule",
            "is_customize": true,
            "hp": { },
            "sub_models": {
              "BinaryCrossEntropyLossForRerankScore": {
                "name": "BinaryCrossEntropyLossForRerankScore",
                "path": "modeling/generic/sequential/loss_modules.py",
                "cls_name": "BinaryCrossEntropyLossForRerankScore",
                "is_customize": true,
                "hp": { },
                "sub_models": {
                  "DefaultLossMask": {
                    name: "DefaultLossMask",
                    "path": "modeling/generic/sequential/loss_mask_modules.py",
                    "cls_name": "DefaultLossMask",
                    "is_customize": true,
                    "hp": { }
                  },
                }
              },
              "LossAggregator": {
                "name": "SumLossAggregator",
                "path": "modeling/generic/sequential/loss_modules.py",
                "cls_name": "SumLossAggregator",
                "is_customize": true,
                "hp": { }
              }
            }
          },
          "OutputPostprocessorModule": {
            "name": "L2NormEmbeddingPostprocessor",
            "path": "modeling/generic/sequential/output_postprocessors.py",
            "cls_name": "L2NormEmbeddingPostprocessor",
            "is_customize": true,
            "hp": { }
          },
          "DLRMModule": {
            "name": "DLRM",
            "path": "modeling/generic/sequential/dlrm.py",
            "cls_name": "DLRM",
            "is_customize": true,
            "item_embedding_dim": 256,
            "hp": {
              # DLRM模块开关
              'use_dlrm_can': False,
              'can_as_dcn_input': False,
              'can_as_dnn_input': False,
              'can_as_final_input': False,
              'use_dlrm_linear': False,
              'use_dlrm_cross': False,
              'use_dlrm_dnn': False,
              'use_dlrm_ppnet': False,

              # 序列特征开关
              'seq_as_cross_input': False,
              'seq_as_dnn_input': False,
              'seq_as_ppnet_input': False,
              'seq_as_final_input': True,

              # CAN配置模块
              'can_input_dim': 16,
              'can_hidden_dims': [8, 4],
              'can_selected_features': [
                    "app_id",
                    "app_size",
                    "first_grade",
                    "dev_up_id",
                    "app_second_type",
                    "app_third_type",
                    "game_type_cd",
                    "first_time_days",
                    "game_type",
                    "ctype",
                    "list_id",
                    "is_down_target_item_flag",
                    "is_pay_target_item_flag",
                    "is_use_tagert_item_flag",
                    "user_match_item_profile_flag",
                    "age_gender_profile_list",
                    "browse_game_app_list_w2",
                    "click_not_down_game_app_list_w2",
                    "use_game_app_list_w2",
                    "down_game_app_list_w2",
                    "user_down_list_search_stype_180d",
                    "user_down_list_search_ttype_180d",
                    "down_game_list_180d",
                    "usage_game_list_180d",
                    "down_pure_app_list_180d",
                    "user_pay_list_360",
                    "use_pure_app_list_180d",
              ],

              # DCN配置
              'num_cross_layers': 3,

              # DNN配置
              'dnn_hidden_layers': [1024, 512, 256, 128],
              'dnn_act_func': 'relu',
              'dnn_dropout_rate': 0.1,
              'dnn_use_bn': 'batch_norm',
              'norm_before_dnn_act': "relu",
              'norm_before_dnn_order': 'a',
              'dnn_orders': 'nda',
              'norm_after_dnn_order': 'nd',

              # PPNet配置
              # 基线复现头配置，对齐modelflow里的POSO分支: 1024/512/256/128
              'baseline_hidden_dims': [1024, 512, 256, 128],
              'baseline_dropout_rate': 0.1,
              'ppnet_gate_features': [
                    "domain_type1",
