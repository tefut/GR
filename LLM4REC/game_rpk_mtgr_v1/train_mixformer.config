                "name": "MTAttentionMask",
                "path": "modeling/generic/sequential/attn_mask_modules.py",
                "cls_name": "MTAttentionMask",
                "is_customize": true,
                "hp": { }
              }
            }
          },
          "EmbeddingModule": {
            "name": "LocalEmbeddingModuleWithSideInfo",
            "path": "modeling/generic/sequential/embedding_modules.py",
            "cls_name": "LocalEmbeddingModuleWithSideInfo",
            "is_customize": true,
            "hp": {}
          },
          "SRNModule": {
            "name": "SRNModule",
            "path": "modeling/generic/sequential/srn_module.py",
            "cls_name": "SRNModule",
            "is_customize": true,
            "hp": {
              "num_bins": 10,
              "embedding_size": 128,
              "sim_gate_w": 10.0,
              "sim_gate_b": 9.0,
              "sim_gate_trainable": true,
              "binning_type": "default"
            }
          },
          "InputFeaturesPreprocessorModule": {
            "name": "MixFormerFeaturePreprocessor",
            "path": "modeling/generic/sequential/input_features_preprocessors.py",
            "cls_name": "MixFormerFeaturePreprocessor",
            "is_customize": true,
            "hp": {
              "embedding_dropout_rate": 0.2
            }
          },
          "LossModule": {
            "name": "LossModule",
            "path": "modeling/generic/sequential/loss_modules.py",
            "cls_name": "LossModule",
            "is_customize": true,
            "hp": { },
            "sub_models": {
              "BinaryCrossEntropyLossForRerankScore": {
                "name": "BinaryCrossEntropyLossForRerankScore",
                "path": "modeling/generic/sequential/loss_modules.py",
