                "down_game_app_list_w2": {"dim": 64, "max_len": 10, "feature_count": 1414889, "enabled": true, "dtype": "multi", "shared_feat_name": "app_id"},
                "user_down_list_search_stype_180d": {"dim": 64, "max_len": 10, "feature_count": 1414889, "enabled": true, "dtype": "multi", "shared_feat_name": "app_id"},
                "user_down_list_search_ttype_180d": {"dim": 64, "max_len": 10, "feature_count": 1414889, "enabled": true, "dtype": "multi", "shared_feat_name": "app_id"},
                "down_game_list_180d": {"dim": 64, "max_len": 10, "feature_count": 1414889, "enabled": true, "dtype": "multi", "shared_feat_name": "app_id"},
                "usage_game_list_180d": {"dim": 64, "max_len": 10, "feature_count": 1414889, "enabled": true, "dtype": "multi", "shared_feat_name": "app_id"},
                "down_pure_app_list_180d": {"dim": 64, "max_len": 10, "feature_count": 1414889, "enabled": true, "dtype": "multi", "shared_feat_name": "app_id"},
                "user_pay_list_360": {"dim": 64, "max_len": 10, "feature_count": 1414889, "enabled": true, "dtype": "multi", "shared_feat_name": "app_id"},
                "use_pure_app_list_180d": {"dim": 64, "max_len": 10, "feature_count": 1414889, "enabled": true, "dtype": "multi", "shared_feat_name": "app_id"}
            },
            "history_item_feature_columns": {
                "app_id_list": {"dim": 64, "feature_count": 1414889, "enabled": true, "dtype": "int", "shared_feat_name": "app_id"},
                "app_size_list": {"dim": 64, "feature_count": 1414889, "enabled": true, "dtype": "int", "shared_feat_name": "app_size"},
                "first_grade_list": {"dim": 64, "feature_count": 1414889, "enabled": true, "dtype": "int", "shared_feat_name": "first_grade"},
                "dev_up_id_list": {"dim": 64, "feature_count": 1414889, "enabled": true, "dtype": "int", "shared_feat_name": "dev_up_id"},
                "app_second_type_list": {"dim": 64, "feature_count": 1414889, "enabled": true, "dtype": "int", "shared_feat_name": "app_second_type"},
                "app_third_type_list": {"dim": 64, "feature_count": 1414889, "enabled": true, "dtype": "int", "shared_feat_name": "app_third_type"},
                "game_type_cd_list": {"dim": 64, "feature_count": 1414889, "enabled": true, "dtype": "int", "shared_feat_name": "game_type_cd"},
                "first_time_days_list": {"dim": 64, "feature_count": 1414889, "enabled": true, "dtype": "int", "shared_feat_name": "first_time_days"},
                "ctype_list": {"dim": 64, "feature_count": 1414889, "enabled": true, "dtype": "int", "shared_feat_name": "ctype"},
                "app_cn_name_list": {"dim": 64, "feature_count": 1414889, "enabled": true, "dtype": "int", "shared_feat_name": "app_cn_name_list"}
            },
            "raw_item_info_column": "",
            "user_feature_columns": {
                "product_name": {"dim": 64, "feature_count": 1414889, "enabled": true, "dtype": "int", "shared_feat_name": "product_name"},
                "activa_durati_day": {"dim": 64, "feature_count": 1414889, "enabled": true, "dtype": "int", "shared_feat_name": "activa_durati_day"},
                "city": {"dim": 64, "feature_count": 1414889, "enabled": true, "dtype": "int", "shared_feat_name": "city"},
                "gender_age": {"dim": 64, "feature_count": 1414889, "enabled": true, "dtype": "int", "shared_feat_name": "gender_age"},
                "age": {"dim": 64, "feature_count": 1414889, "enabled": true, "dtype": "int", "shared_feat_name": "age"},
                "gender": {"dim": 64, "feature_count": 1414889, "enabled": true, "dtype": "int", "shared_feat_name": "gender"},
                "domain_type1": {"dim": 64, "feature_count": 60, "enabled": true, "dtype": "int", "shared_feat_name": "domain_type1"}
            },
            "feature_groups": {
              "candidate_dlrm": {
                "features": [
                    "app_id", "app_size", "first_grade", "dev_up_id",
                    "app_second_type", "app_third_type", "game_type_cd",
                    "first_time_days", "game_type", "ctype", "list_id",
                    "is_down_target_item_flag", "is_pay_target_item_flag",
                    "is_use_tagert_item_flag", "user_match_item_profile_flag",
                    "age_gender_profile_list", "browse_game_app_list_w2",
                    "click_not_down_game_app_list_w2", "use_game_app_list_w2",
                    "down_game_app_list_w2", "user_down_list_search_stype_180d",
                    "user_down_list_search_ttype_180d", "down_game_list_180d",
                    "usage_game_list_180d", "down_pure_app_list_180d",
                    "user_pay_list_360", "use_pure_app_list_180d"
                ]
              },
              "candidate": {
                "fusion": "concat",
                "features": [
                    "app_id", "app_size", "first_grade", "dev_up_id",
                    "app_second_type", "app_third_type", "game_type_cd",
                    "first_time_days", "game_type", "ctype", "list_id",
                    "is_down_target_item_flag", "is_pay_target_item_flag",
                    "is_use_tagert_item_flag", "user_match_item_profile_flag",
                    "age_gender_profile_list", "browse_game_app_list_w2",
                    "click_not_down_game_app_list_w2", "use_game_app_list_w2",
                    "down_game_app_list_w2", "user_down_list_search_stype_180d",
                    "user_down_list_search_ttype_180d", "down_game_list_180d",
                    "usage_game_list_180d", "down_pure_app_list_180d",
                    "user_pay_list_360", "use_pure_app_list_180d"
                ],
                "mlp": {
                  "hidden_dims": [512],
                  "act_fn": "gelu"
                },
                "gluffn": {
                  "ffn_dim_multiplier": 6
                }
              },
              "history": {
                "fusion": "gluffn",
                "history": {
                  "features": [
                    "app_id_list", "app_size_list", "first_grade_list",
                    "dev_up_id_list", "app_second_type_list", "app_third_type_list",
                    "game_type_cd_list", "first_time_days_list", "ctype_list",
                    "app_cn_name_list"
                  ]
                },
                "mlp": {
                  "hidden_dims": [512],
                  "act_fn": "gelu"
                },
                "gluffn": {
                  "ffn_dim_multiplier": 6
                }
              },
              "user": {
                "fusion": "concat",
                "features": [
                    "product_name", "activa_durati_day", "city",
                    "gender_age", "age", "gender", "domain_type1"
                ],
                "mlp": {
                  "hidden_dims": [512],
                  "act_fn": "gelu"
                },
                "gluffn": {
                  "ffn_dim_multiplier": 6
                }
              }
            },
            "metric_list": [
              { "tag": "mean" },
              { "tag": "variance" },
              { "tag": "stddev" },
              { "tag": "logloss" },
              { "tag": "pcoc" },
              { "tag": "auc" }
            ]
          }
      },
      "model_cfg": {
        "name": "MixFormerModel",
        "path": "modeling/generic/sequential/mixformer_model.py",
        "cls_name": "MixFormerModel",
        "is_customize": true,
        "hp": {
          "verbose": true,
          "num_blocks": 8,
          "use_sid": true,
          "sid_fusion_pos": "input",
          "sid_agg_type": "concat",
          "sid_D": 64,
          "sid_Ks": [256, 256, 256],
          "appid2sids_path": "/home/ma-user/work/dataset/game_gr_data_jw/sid/appid2sids.txt",
          "id_col_name": "app_id",
          "code_col_name": "code",
          "cumsum": true,
          "unique": false,
          "app_zero": true,
          "sid_decoder_in_dropout": 0.2,
          "sid_gen_loss_w": 0.1,
          "sid_gen_loss_strat": "unlikelihood",
          "unlikelihood_w": 0.5,
          "sid_decoder_as_dlrm_input": false,
          "sid_decoder_tau": 0.5
        },
        "sub_models": {
          "AttentionMaskModule": {
            "name": "AttentionMaskModule",
            "path": "modeling/generic/sequential/attn_mask_modules.py",
