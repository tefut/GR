            "cls_name": "L2NormEmbeddingPostprocessor",
            "is_customize": true,
            "hp": { }
          },
          "FeedForwardModule": {
            "name": "FeedForwardModule",
            "path": "modeling/generic/sequential/prediction_modules.py",
            "cls_name": "FeedForwardModule",
            "is_customize": true,
            "hp": { },
            "sub_models": {
              "LinearModuleForRerankScore": {
                "name": "LinearModuleForRerankScore",
                "path": "modeling/generic/sequential/prediction_modules.py",
                "cls_name": "LinearModuleForRerankScore",
                "is_customize": true,
                "hp": {
                    "input_dim": 1024, # n_c * D + n_u*D (if use_user_embedding_for_rerank = true)
